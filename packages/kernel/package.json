{
  "name": "@volund/kernel",
  "version": "0.1.1",
  "description": "Volund kernel — Cordis context tree and service runtime spine",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build/rewrite-esm-specifiers.mjs dist",
    "test": "vitest run --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cordisjs/core": "catalog:",
    "@volund/core": "workspace:*",
    "@volund/provider-kit": "workspace:*",
    "@volund/shared": "workspace:*",
    "@volund/tool-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@volund/testkit": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
